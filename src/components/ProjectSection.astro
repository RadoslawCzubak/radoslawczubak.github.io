---
import ProjectCard from "./ProjectCard.astro";

const placeholderProjects = [
  {
    title: "ViCare - Native Android and iOS application for IoT",
    description: "A brief description of Project Alpha. This project involved building a mobile application for managing tasks.",
    screenshots: ["/src/assets/vicare-project-image.png"],
  },
  {
    title: "Project Beta",
    description: "Details about Project Beta. This was a web-based application with a focus on data visualization.",
    screenshots: ["/path/to/placeholder-image3.png"],
  },
  {
    title: "Project Gamma",
    description: "An exciting project called Project Gamma. It's a cross-platform mobile game.",
    screenshots: ["/path/to/placeholder-image4.png", "/path/to/placeholder-image5.png", "/path/to/placeholder-image6.png"],
  },
];
---

<div id="project-container">
  <h2>EXPERIENCE</h2>
  <div class="projects-grid">
    {placeholderProjects.map(project => (
      <ProjectCard
        title={project.title}
        description={project.description}
        screenshots={project.screenshots}
      />
    ))}
  </div>
</div>

<style>
  #project-container {
    color: white;
    font-family: Montserrat, Helvetica, sans-serif;
    padding: 40px 20px; /* Add some padding */
    text-align: center; /* Center the title */
  }

  #project-container h2 {
    color: white;
    font-size: 32px;
    text-transform: uppercase;
    font-family: Montserrat, Helvetica, sans-serif;
    margin-bottom: 40px; /* Space below the title */
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); /* Responsive grid */
    gap: 40px; /* Space between cards */
    justify-items: center; /* Center items in the grid */
    max-width: 1200px; /* Limit grid width */
    margin: 0 auto; /* Center the grid */
  }
</style>